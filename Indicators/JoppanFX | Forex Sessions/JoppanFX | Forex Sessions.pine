//@version=6
// @description JoppanFX | Forex Sessions
// @author JoppanFX
// @documentation https://github.com/joppanfx/Pine-Script-Projects

indicator("JoppanFX | Forex Sessions", overlay=true, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────
// --- User Inputs ---
// ─────────────────────────────────────────────

// Sydney
syd_grp        = "Sydney Session"
syd_start_inp  = input.int(21, "Sydney Start Hour (UTC)", minval=0, maxval=23, group=syd_grp)
syd_end_inp    = input.int(6,  "Sydney End Hour (UTC)",   minval=0, maxval=23, group=syd_grp)
syd_color      = input.color(color.rgb(255, 192, 203), "Sydney Color", group=syd_grp)

// Tokyo
tok_grp        = "Tokyo Session"
tok_start_inp  = input.int(0,  "Tokyo Start Hour (UTC)", minval=0, maxval=23, group=tok_grp)
tok_end_inp    = input.int(9,  "Tokyo End Hour (UTC)",   minval=0, maxval=23, group=tok_grp)
tok_color      = input.color(color.rgb(138, 43, 226), "Tokyo Color", group=tok_grp)

// London
lon_grp        = "London Session"
lon_start_inp  = input.int(7,  "London Start Hour (UTC)", minval=0, maxval=23, group=lon_grp)
lon_end_inp    = input.int(16, "London End Hour (UTC)",   minval=0, maxval=23, group=lon_grp)
lon_color      = input.color(color.yellow, "London Color", group=lon_grp)

// New York
ny_grp         = "New York Session"
ny_start_inp   = input.int(12, "New York Start Hour (UTC)", minval=0, maxval=23, group=ny_grp)
ny_end_inp     = input.int(21, "New York End Hour (UTC)",   minval=0, maxval=23, group=ny_grp)
ny_color       = input.color(color.blue, "New York Color", group=ny_grp)

// ─────────────────────────────────────────────
// --- Warning Note ---
// ─────────────────────────────────────────────
// NOTE: Session detection is based on UTC hour values only. On sub-hourly timeframes,
// the first bar of a session may not align exactly with the defined start hour depending
// on the chart's bar boundaries. This is a known limitation.

// ─────────────────────────────────────────────
// --- Session Logic (UTC-Based) ---
// ─────────────────────────────────────────────
isInSession(startHour, endHour) =>
    h = hour(time, "UTC")
    bool result = false
    if startHour < endHour
        result := (h >= startHour and h < endHour)
    else
        result := (h >= startHour or h < endHour)
    result

// --- Session States ---
syd_in = isInSession(syd_start_inp, syd_end_inp)
tok_in = isInSession(tok_start_inp, tok_end_inp)
lon_in = isInSession(lon_start_inp, lon_end_inp)
ny_in  = isInSession(ny_start_inp,  ny_end_inp)

// --- Session Transitions ---
syd_start = syd_in and not syd_in[1]
syd_end   = not syd_in and syd_in[1]

tok_start = tok_in and not tok_in[1]
tok_end   = not tok_in and tok_in[1]

lon_start = lon_in and not lon_in[1]
lon_end   = not lon_in and lon_in[1]

ny_start  = ny_in and not ny_in[1]
ny_end    = not ny_in and ny_in[1]

// ─────────────────────────────────────────────
// --- Dynamic Contrast Logic ---
// ─────────────────────────────────────────────
r = color.r(chart.bg_color)
g = color.g(chart.bg_color)
b = color.b(chart.bg_color)

luminance    = (0.299 * r + 0.587 * g + 0.114 * b)
dynamicColor = luminance > 127.5 ? color.black : color.white

// ─────────────────────────────────────────────
// --- Watermark ---
// ─────────────────────────────────────────────
var watermarkTable = table.new(position.bottom_right, 1, 1)

if barstate.islast
    table.cell(
         watermarkTable,
         0,
         0,
         "JoppanFX",
         text_color=color.new(dynamicColor, 50),
         text_size=size.small,
         bgcolor=color.new(chart.bg_color, 100)
     )

// ─────────────────────────────────────────────
// --- Visual Markers (Session Start/End Labels) ---
// ─────────────────────────────────────────────

// Sydney (Pink)
if syd_start
    label.new(bar_index, high, "Sydney Start", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color(na), textcolor=syd_color, style=label.style_label_down, size=size.normal)
if syd_end
    label.new(bar_index, high, "Sydney End", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color(na), textcolor=syd_color, style=label.style_label_down, size=size.normal)

// Tokyo (Violet)
if tok_start
    label.new(bar_index, high, "Tokyo Start", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color(na), textcolor=tok_color, style=label.style_label_down, size=size.normal)
if tok_end
    label.new(bar_index, high, "Tokyo End", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color(na), textcolor=tok_color, style=label.style_label_down, size=size.normal)

// London (Yellow)
if lon_start
    label.new(bar_index, high, "London Start", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color(na), textcolor=lon_color, style=label.style_label_down, size=size.normal)
if lon_end
    label.new(bar_index, high, "London End", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color(na), textcolor=lon_color, style=label.style_label_down, size=size.normal)

// New York (Blue)
if ny_start
    label.new(bar_index, high, "NewYork Start", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color(na), textcolor=ny_color, style=label.style_label_down, size=size.normal)
if ny_end
    label.new(bar_index, high, "NewYork End", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color(na), textcolor=ny_color, style=label.style_label_down, size=size.normal)

// ─────────────────────────────────────────────
// --- Session Boxes (Dynamic Range Tracking) ---
// ─────────────────────────────────────────────
draw_session_box(start, end, inside, clr) =>
    var box   sess_box = na
    var float hi       = na
    var float lo       = na
    var line  v_start  = na
    var line  v_end    = na

    // --- Session Start ---
    if start
        hi        := high
        lo        := low
        sess_box  := box.new(left=bar_index, right=bar_index, top=hi, bottom=lo, bgcolor=color.new(clr, 85), border_width=0)
        v_start   := line.new(bar_index, hi, bar_index, lo, color=clr, width=1)

    // --- Expand While Inside ---
    if inside and not na(sess_box)
        hi := math.max(high, hi)
        lo := math.min(low, lo)
        box.set_right(sess_box, bar_index)
        box.set_top(sess_box, hi)
        box.set_bottom(sess_box, lo)

        if not na(v_start)
            line.set_y1(v_start, hi)
            line.set_y2(v_start, lo)

    // --- Session End ---
    if end and not na(sess_box)
        box.set_right(sess_box, bar_index)
        v_end    := line.new(bar_index, hi, bar_index, lo, color=clr, width=1)

        sess_box := na
        hi       := na
        lo       := na

// --- Draw Session Boxes ---
draw_session_box(syd_start, syd_end, syd_in, syd_color)
draw_session_box(tok_start, tok_end, tok_in, tok_color)
draw_session_box(lon_start, lon_end, lon_in, lon_color)
draw_session_box(ny_start,  ny_end,  ny_in,  ny_color)

// ─────────────────────────────────────────────
// --- Session High/Low Tracking ---
// ─────────────────────────────────────────────
calc_hl(bool start, bool end, bool inside, color clr) =>
    var float hi   = na
    var float lo   = na
    var line  l_hi = na
    var line  l_lo = na
    var label lbl_hi = na
    var label lbl_lo = na

    // --- Session Start ---
    if start
        hi := high
        lo := low

        l_hi := line.new(bar_index, hi, bar_index, hi, color=clr)
        l_lo := line.new(bar_index, lo, bar_index, lo, color=clr)

        lbl_hi := label.new(bar_index, high, "Session High", style=label.style_label_down, color=clr, textcolor=color.white)
        lbl_lo := label.new(bar_index, low,  "Session Low",  style=label.style_label_up,   color=clr, textcolor=color.white)

    // --- Update While Inside ---
    if inside and not na(hi)
        hi := math.max(high, hi)
        lo := math.min(low, lo)

        line.set_xy2(l_hi, bar_index, hi)
        line.set_y1(l_hi, hi)

        line.set_xy2(l_lo, bar_index, lo)
        line.set_y1(l_lo, lo)

        label.set_xy(lbl_hi, bar_index, hi)
        label.set_xy(lbl_lo, bar_index, lo)

    // --- Session End ---
    if end and not na(hi)
        line.set_xy2(l_hi, bar_index, hi)
        line.set_xy2(l_lo, bar_index, lo)

        hi := na
        lo := na

        label.set_xy(lbl_hi, bar_index, hi)
        label.set_xy(lbl_lo, bar_index, lo)

// --- Execute High/Low Tracking ---
calc_hl(syd_start, syd_end, syd_in, syd_color)
calc_hl(tok_start, tok_end, tok_in, tok_color)
calc_hl(lon_start, lon_end, lon_in, lon_color)
calc_hl(ny_start,  ny_end,  ny_in,  ny_color)
