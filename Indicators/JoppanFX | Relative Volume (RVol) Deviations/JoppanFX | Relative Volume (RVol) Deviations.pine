//@version=6
// @description JoppanFX | Relative Volume (RVol) Deviations
// @author JoppanFX
// @documentation https://github.com/joppanfx/Pine-Script-Projects/tree/main/Indicators/JoppanFX%20%7C%20Relative%20Volume%20(RVol)%20Deviations
indicator("JoppanFX | Relative Volume (RVol) Deviations", overlay=true, max_labels_count=500)

// --- Constants ---
LABEL_TRANSPARENCY = 20

// --- Inputs ---
group_vol  = "Volume Settings"
group_vis  = "Visuals"
len        = input.int(60, "Lookback Period", minval=1, group=group_vol)
mult       = input.float(2.5, "Volume Multiplier", step=0.1, minval=0.1, group=group_vol)
bullColor  = input.color(color.new(#00ff08, 0), "High Vol Bullish", group=group_vis)
bearColor  = input.color(color.new(#ff0055, 0), "High Vol Bearish", group=group_vis)
dojiColor  = input.color(color.new(#ffffff, 0), "High Vol Doji (Neutral)", group=group_vis)
showLabels = input.bool(true, "Show Volume Labels", group=group_vis)
labelOffset = input.float(0.25, "Label ATR Offset (Multiplier)", minval=0.0, step=0.05, group=group_vis)

// --- Volume Availability Check ---
bool hasVolume = not na(volume) and volume >= 0

// --- Calculations ---
avgVol       = hasVolume ? ta.sma(volume, len) : na
bool isWarm  = bar_index >= len
bool isHighVolume = hasVolume and not na(avgVol) and avgVol > 0 and isWarm and volume > (avgVol * mult)

// --- Candle Classification ---
bool isDoji    = math.abs(close - open) <= syminfo.mintick
bool isBullish = isHighVolume and close > open and not isDoji
bool isBearish = isHighVolume and close < open and not isDoji
bool isDojiBar = isHighVolume and isDoji

// --- ATR-Based Label Offset ---
atrOffset = ta.atr(14) * labelOffset

// --- Dynamic Contrast Logic ---
r = color.r(chart.bg_color)
g = color.g(chart.bg_color)
b = color.b(chart.bg_color)
luminance = (0.299 * r + 0.587 * g + 0.114 * b)
dynamicColor = luminance > 127.5 ? color.black : color.white

// --- Watermark ---
var watermarkTable = table.new(position.bottom_right, 1, 1)
if barstate.islast
    table.cell(watermarkTable, 0, 0, "JoppanFX", text_color=color.new(dynamicColor, 50), text_size=size.small, bgcolor=color.new(chart.bg_color, 100))

// --- Plotting ---
// 1. Bar Coloring
barcolor(isBullish ? bullColor : isBearish ? bearColor : isDojiBar ? dojiColor : na)

// 2. Labels with ATR-Based Offset
if isHighVolume and showLabels
    volMultiplier = avgVol > 0 ? (volume / avgVol) : na

    if not na(volMultiplier)
        labelStyle = isBullish ? label.style_label_up : isBearish ? label.style_label_down : label.style_label_left
        labelColor = isBullish ? bullColor : isBearish ? bearColor : dojiColor
        labelY     = isBullish ? (low - atrOffset) : (high + atrOffset)

        label.new(
             x=bar_index,
             y=labelY,
             text=str.format("{0,number,#.#}x", volMultiplier),
             style=labelStyle,
             color=color.new(labelColor, LABEL_TRANSPARENCY),
             textcolor=dynamicColor,
             size=size.tiny,
             yloc=yloc.price
             )
